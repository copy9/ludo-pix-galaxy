# Copie para .env e preencha. O .env NAO vai para o repositorio.
# Em desenvolvimento nada aqui e obrigatorio: sem PSP_API_KEY os pagamentos
# sao simulados e nao movimentam dinheiro de verdade.

PORT=3000
NODE_ENV=development

# Onde fica o banco. Precisa estar em disco persistente e ter backup.
# DATA_DIR=/var/lib/ludopix

# ---- Gateway de pagamento ----
# Em producao o servidor RECUSA subir sem estas duas.
PSP_NAME=
PSP_API_KEY=
# Segredo usado para conferir a assinatura dos webhooks.
# Confira o formato na documentacao do seu gateway antes de confiar nela:
# assinatura conferida errado e o mesmo que nao conferir.
PSP_WEBHOOK_SECRET=

# ---- Operacao ----
# Protege GET /api/_audit (integridade do livro-razao).
ADMIN_TOKEN=

# Origens extras permitidas em POST, separadas por virgula (anti-CSRF).
# ALLOWED_ORIGINS=https://ludopixgalaxy.com

# 1 quando houver nginx/Cloudflare na frente, para o rate limit enxergar o IP real.
# Deixe em 0 se o servidor estiver exposto direto: senao qualquer um forja
# X-Forwarded-For e escapa do limite.
TRUST_PROXY=0

# ---- Limites de taxa (opcional) ----
# RL_REGISTER=40        cadastros por hora, por IP
# RL_LOGIN_EMAIL=10     tentativas de login por e-mail, a cada 15 min
# RL_LOGIN_IP=100       tentativas de login por IP, a cada 15 min
