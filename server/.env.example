# =====================================================================
# Ludo Pix Galaxy — configuração do servidor
#
# Copie para `server/.env` e preencha. O servidor valida tudo na partida e
# se recusa a subir se faltar algo essencial em produção.
#
# NUNCA comite o arquivo .env. Se uma chave real entrar no histórico do git,
# trate-a como vazada e faça a rotação no provedor.
# =====================================================================

NODE_ENV=development
PORT=3000

# Endereço público do site. Em produção TEM que ser https:// — o cookie de
# sessão é marcado Secure e simplesmente não funciona em http.
PUBLIC_URL=http://localhost:3000

# ---------------------------------------------------------------------
# Banco
# ---------------------------------------------------------------------
DATABASE_URL=postgres://ludo:senha@localhost:5432/ludo
DATABASE_SSL=false

# ---------------------------------------------------------------------
# Sessões
# Gere com: openssl rand -hex 32
# Trocar este valor derruba todas as sessões ativas (é o efeito desejado
# se você suspeitar de vazamento).
# ---------------------------------------------------------------------
SESSION_SECRET=
SESSION_TTL_HOURS=72

# ---------------------------------------------------------------------
# Pagamentos
#
# PAYMENT_PROVIDER=mock credita saldo SEM COBRAR NINGUÉM. Serve para
# desenvolvimento. O servidor recusa subir com mock em produção.
#
# Para trocar de provedor (Asaas, Efí, PSP do seu banco), copie
# server/src/modules/payments/providers/mercadopago.js, implemente o mesmo
# contrato e registre o nome em provider.js.
# ---------------------------------------------------------------------
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# ---------------------------------------------------------------------
# Regras de negócio (valores em CENTAVOS)
# ---------------------------------------------------------------------

# Comissão da casa em pontos-base: 2000 = 20%. Teto de 5000 (50%).
# Fica congelada em cada desafio no momento da criação, então mudar aqui
# não altera partidas já em andamento.
COMMISSION_BPS=2000

MIN_DEPOSIT_CENTS=500          # R$ 5,00
MAX_DEPOSIT_CENTS=500000       # R$ 5.000,00
MIN_WITHDRAWAL_CENTS=1000      # R$ 10,00
MIN_STAKE_CENTS=100            # R$ 1,00
MAX_STAKE_CENTS=100000         # R$ 1.000,00

# Quanto tempo um desafio fica aberto esperando adversário.
CHALLENGE_TTL_MINUTES=30

# Tempo de cada turno. Estourou, o jogador perde a vez — impede que alguém
# trave uma partida valendo dinheiro simplesmente não jogando.
TURN_TIMEOUT_SECONDS=90

# ---------------------------------------------------------------------
# Rede
# Ative só se houver um proxy reverso (nginx, Cloudflare) à frente. Com
# TRUST_PROXY=true sem proxy real, qualquer um forja o próprio IP pelo
# cabeçalho X-Forwarded-For e escapa do rate limit.
# ---------------------------------------------------------------------
TRUST_PROXY=false
